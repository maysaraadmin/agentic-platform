{
  "name": "mfe-chat",
  "$schema": "https://json.schemastore.org/project.json",
  "sourceRoot": "src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:webpack",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/mfe-chat",
        "main": "apps/frontend/mfe-chat/src/main.tsx",
        "tsConfig": "apps/frontend/mfe-chat/tsconfig.json",
        "webpackConfig": "apps/frontend/mfe-chat/webpack.config.js",
        "index": "apps/frontend/mfe-chat/src/index.html"
      }
    },
    "serve": {
      "executor": "nx:webpack-dev-server",
      "options": {
        "buildTarget": "mfe-chat:build",
        "port": 3001
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/frontend/mfe-chat/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  },
  "tags": []
}
