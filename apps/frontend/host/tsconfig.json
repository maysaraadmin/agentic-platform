{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "mfe-chat/*": ["../mfe-chat/src/*"],
      "mfe-dashboard/*": ["../mfe-dashboard/src/*"],
      "shared/*": ["../shared/src/*"]
    },
    "outDir": "dist",
    "rootDir": ".."
  },
  "include": ["src/**/*", "../shared/src/**/*"],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.test.tsx"]
}
