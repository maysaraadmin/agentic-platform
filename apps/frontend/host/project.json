{
  "name": "host",
  "$schema": "https://json.schemastore.org/project.json",
  "sourceRoot": "src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:webpack",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/host",
        "main": "apps/frontend/host/src/main.tsx",
        "tsConfig": "apps/frontend/host/tsconfig.json",
        "webpackConfig": "apps/frontend/host/webpack.config.js",
        "index": "apps/frontend/host/src/index.html",
        "baseHref": "/",
        "compiler": "babel",
        "assets": ["apps/frontend/host/src/favicon.ico", "apps/frontend/host/src/assets"]
      }
    },
    "serve": {
      "executor": "nx:webpack-dev-server",
      "options": {
        "buildTarget": "host:build",
        "hmr": true,
        "port": 4200
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/frontend/host/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  },
  "tags": []
}
